# Optional overrides for docker-compose.yml (development-only defaults shown).
# Copy to .env in the repository root — never commit the real file.
#
# For running the backend outside Docker, use apps/backend/.env.example instead.
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting
POSTGRES_DB=meeting_workspace
POSTGRES_PORT=5435

# Passed to the backend container only. Leave empty until you have a key;
# without one the stack still runs and only "Analyze with Claude" answers 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# "anthropic" (default) calls the Claude API; "fake" returns a deterministic canned analysis.
MEETING_ANALYZER=anthropic
