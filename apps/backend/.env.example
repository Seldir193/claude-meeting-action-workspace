# Copy to apps/backend/.env — never commit the real file.

# Matches the local docker-compose PostgreSQL service (development-only credentials).
DATABASE_URL=postgresql://meeting:meeting@localhost:5435/meeting_workspace

PORT=3001
CORS_ORIGIN=http://localhost:4200

# Backend-only secret. Leave empty until you have a key; never expose it to the frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# "anthropic" (default) calls the Claude API; "fake" returns a deterministic canned analysis.
MEETING_ANALYZER=anthropic
